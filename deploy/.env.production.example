# Продакшн-шаблон .env для сервера. Скопировать в /opt/promproduct/.env (`cp deploy/.env.production.example .env`)
# и заполнить отмеченные строки. Локальная разработка использует .env.example в корне проекта.

# --- Django ---
DEBUG=False
# Сгенерировать: openssl rand -base64 48 | tr -d '\n=/+'
SECRET_KEY=change-me-generate-with-openssl-rand-base64-48
ALLOWED_HOSTS=prom-products.kz,new.prom-products.kz
CSRF_TRUSTED_ORIGINS=https://prom-products.kz,https://new.prom-products.kz
# На стенде — https://new.prom-products.kz; после переключения домена — https://prom-products.kz
SITE_URL=https://new.prom-products.kz
# Заполнить своим суффиксом: openssl rand -hex 6; адрес никому не публиковать
ADMIN_URL=panel-<суффикс>/

# --- Database ---
POSTGRES_DB=promproduct
POSTGRES_USER=promproduct
# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# Пароль должен совпадать со значением POSTGRES_PASSWORD выше
DATABASE_URL=postgres://promproduct:change-me-generate-with-openssl-rand-hex-24@db:5432/promproduct

# --- Cache ---
# LocMemCache на продакшене не годится: у каждого из 3 воркеров gunicorn свой процесс и своя память,
# из-за чего общие лимиты (например, 5 заявок в час с одного IP) считаются раздельно по воркерам.
CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=django_cache

# --- Email ---
# Gmail: пароль приложения без пробелов, @ в логине → %40
EMAIL_URL=submission://<логин>%40gmail.com:<пароль-приложения>@smtp.gmail.com:587
DEFAULT_FROM_EMAIL=<логин>@gmail.com
ADMIN_EMAIL=<почта для заявок>

# --- Media ---
MEDIA_ROOT=/app/media

# --- Docker (сервер) ---
WEB_PORT=8001
